---
import { siteConfig, services, cities } from '../data/siteConfig';

const { businessName, phone, email, address, hours } = siteConfig;

const currentYear = new Date().getFullYear();

// Top 4 cities for footer quick links
const topCities = cities.slice(0, 4);

// Filter out empty social links
const activeSocials = Object.entries(siteConfig.social).filter(([_, url]) => url);

// Social icons SVG paths
const socialIcons: Record<string, string> = {
  facebook: 'M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z',
  instagram: 'M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4H7.6m9.65 1.5a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5M12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10m0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6',
  linkedin: 'M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2zM4 2a2 2 0 1 1 0 4 2 2 0 0 1 0-4',
  youtube: 'M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19.1c1.72.44 8.6.44 8.6.44s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33zM9.75 15.02V8.48l5.75 3.27-5.75 3.27z',
  twitter: 'M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z',
  yelp: 'M20.16 12.73l-4.26 1.69a.49.49 0 0 1-.63-.26l-.07-.15a.5.5 0 0 1 .17-.6l3.83-2.92a.5.5 0 0 1 .73.12l.22.37a.5.5 0 0 1-.01.52l.02.23z',
};
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Brand Column -->
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label={`${businessName} - Home`}>
          <div class="logo-icon" style="width:36px;height:36px;font-size:1.1rem;display:flex;align-items:center;justify-content:center;background:var(--color-primary);border-radius:6px;">🚽</div>
          <span>{businessName}</span>
        </a>
        <p>
          Serving {address.state} with 24/7 licensed toilet repair, unclogging, and emergency plumbing.
          Upfront flat-rate pricing before any work starts.
        </p>
        <p style="margin-top: 0.75rem;">
          <a href={`tel:${phone.replace(/[^+\d]/g, '')}`} style="color: var(--color-accent); font-weight: 700; font-size: 1.125rem;">
            📞 {phone}
          </a>
        </p>
        {activeSocials.length > 0 && (
          <div class="footer-social">
            {activeSocials.map(([platform, url]) => (
              <a href={url} target="_blank" rel="noopener" aria-label={`Follow us on ${platform}`}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d={socialIcons[platform] || ''} />
                </svg>
              </a>
            ))}
          </div>
        )}
      </div>

      <!-- Quick Links -->
      <div class="footer-col">
        <h4>Quick Links</h4>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/services/">Services</a></li>
          <li><a href="/locations/">Locations</a></li>
          <li><a href="/about-us/">About Us</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/contact-us/">Contact Us</a></li>
        </ul>
      </div>

      <!-- Services -->
      <div class="footer-col">
        <h4>Our Services</h4>
        <ul>
          {services.map(service => (
            <li><a href={`/services/${service.slug}/`}>{service.name}</a></li>
          ))}
        </ul>
      </div>

      <!-- Top Locations -->
      <div class="footer-col">
        <h4>Service Areas</h4>
        <ul>
          {cities.slice(0, 6).map(city => (
            <li><a href={`/locations/${city.slug}/`}>{city.name}, CT</a></li>
          ))}
          <li><a href="/locations/" style="font-weight: 600; color: var(--color-accent);">All 208 CT Cities →</a></li>
        </ul>
        <div style="margin-top: 1.5rem;">
          <h4>Hours</h4>
          <ul>
            <li style="color: rgba(208,208,208,0.6); font-size: 0.8125rem;">{hours.weekday}</li>
            <li style="color: rgba(208,208,208,0.6); font-size: 0.8125rem;">{hours.saturday}</li>
            <li style="color: rgba(208,208,208,0.6); font-size: 0.8125rem;">{hours.sunday}</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Footer Bottom -->
    <div class="footer-bottom">
      <p>&copy; {currentYear} {businessName}. All rights reserved.</p>
      <div class="footer-payments">
        <span>💳 Credit Cards</span>
        <span>🏦 Checks</span>
        <span>💰 Cash</span>
      </div>
    </div>
  </div>
</footer>
