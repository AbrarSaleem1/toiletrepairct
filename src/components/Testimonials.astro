---
import { testimonials } from '../data/siteConfig';
import type { Testimonial } from '../data/siteConfig';

interface Props {
  items?: Testimonial[];
  title?: string;
  subtitle?: string;
}

const {
  items = testimonials,
  title = 'What Our Customers Say',
  subtitle = 'Real feedback from homeowners and businesses across the state.',
} = Astro.props;

function getInitials(name: string): string {
  return name.split(' ').map(n => n[0]).join('').toUpperCase().slice(0, 2);
}
---

<section class="section section-alt" id="testimonials">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-label">Reviews</span>
      <h2>{title}</h2>
      <p>{subtitle}</p>
    </div>

    <div class="testimonials-grid">
      {items.map(testimonial => (
        <div class="testimonial-card reveal">
          <div class="testimonial-stars">
            {Array.from({ length: testimonial.rating }).map(() => (
              <span>★</span>
            ))}
          </div>
          <p class="testimonial-text">{testimonial.text}</p>
          <div class="testimonial-author">
            <div class="testimonial-avatar">{getInitials(testimonial.name)}</div>
            <div>
              <div class="testimonial-name">{testimonial.name}</div>
              <div class="testimonial-location">{testimonial.location}</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
