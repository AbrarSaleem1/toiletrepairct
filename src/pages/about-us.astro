---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import TrustStrip from '../components/TrustStrip.astro';
import Testimonials from '../components/Testimonials.astro';
import CTABand from '../components/CTABand.astro';
import ContactSection from '../components/ContactSection.astro';
import { siteConfig } from '../data/siteConfig';

const { businessName, phone, phoneClean, address, primaryKeyword, experienceYears } = siteConfig;
const state = address.state;

// STRICT SEO LIMITS: Title <= 70 chars, Description <= 160 chars
const pageTitle = `About CT Toilet Repair Co. | 15+ Years Licensed CT Plumbers`;
const pageDescription = `Learn about CT Toilet Repair Co. Over 15 years providing reliable, 24/7 emergency toilet repair across all 208 Connecticut towns. Call (844) 352-0779.`;

// AboutPage schema
const aboutSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": `About ${businessName}`,
  "description": pageDescription,
  "url": `${siteConfig.domain}/about-us/`,
  "mainEntity": {
    "@type": "PlumbingService",
    "name": businessName,
    "telephone": phone,
    "address": {
      "@type": "PostalAddress",
      "streetAddress": address.street,
      "addressLocality": address.city,
      "addressRegion": address.stateAbbr,
      "postalCode": address.zip,
      "addressCountry": "US",
    },
  },
});
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalUrl="/about-us/" schema={aboutSchema}>

  <!-- Hero -->
  <section class="hero hero-sm">
    <div class="hero-bg">
      <div style="width:100%;height:100%;background:linear-gradient(135deg, #052B3B 0%, #0A4D68 50%, #0F172A 100%);"></div>
    </div>
    <div class="hero-overlay" style="background: linear-gradient(135deg, rgba(5,43,59,0.7) 0%, rgba(10,77,104,0.5) 50%, rgba(15,23,42,0.7) 100%);"></div>
    <div class="container">
      <div class="hero-content fade-in-up">
        <Breadcrumb items={[
          { label: 'Home', href: '/' },
          { label: 'About Us' },
        ]} />
        <h1>About {businessName}</h1>
        <p class="hero-subtitle">
          Over {experienceYears} years of licensed expertise, dedicated 24/7 emergency response, and transparent plumbing service across all 208 Connecticut communities.
        </p>
        <div class="btn-group">
          <a href={`tel:${phoneClean}`} class="btn btn-accent btn-lg" style="font-weight: 700;">
            📞 Call 24/7: {phone}
          </a>
        </div>
      </div>
    </div>
  </section>

  <TrustStrip items={[
    { icon: '🛡️', label: 'Licensed CT Plumbers' },
    { icon: '⭐', label: `${experienceYears} Years Experience` },
    { icon: '⏰', label: '24/7 Statewide Dispatch' },
    { icon: '💵', label: 'Upfront Flat Rates' },
  ]} />

  <!-- Our Story -->
  <section class="section" id="our-story">
    <div class="container">
      <div class="about-story reveal">
        <div>
          <span class="section-label">Our Background</span>
          <h2>Specialized Toilet Repair Across Connecticut</h2>
          <p>
            {businessName} was established with one clear goal: to provide Connecticut property owners with dedicated, fast-response toilet repair and drain unclogging that general handymen couldn't match. Headquartered at 11 Andover Dr in West Hartford, our operations have grown to encompass mobile dispatch units positioned throughout all 8 Connecticut counties.
          </p>
          <p>
            Over the past {experienceYears} years, our licensed technicians have encountered every imaginable toilet failure—from cracked cast iron flanges in colonial-era farmhouses to high-pressure commercial flushometer valve malfunctions in corporate office parks.
          </p>
          <p>
            We believe that when a toilet overflows or fails, you deserve straight answers and predictable costs. That's why we never hide behind vague estimates or hourly billing surprises; every job receives a guaranteed upfront flat rate before work begins.
          </p>
        </div>
        <div class="about-image" style="border-radius: var(--radius-lg); overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.12); border: 1px solid var(--color-border); background: var(--color-bg);">
          <img 
            src="/images/toilet-flange-wax-ring-repair.jpg" 
            alt="Licensed master plumbers toilet flange and wax ring repair in Connecticut" 
            width="600" 
            height="400" 
            loading="lazy" 
            decoding="async" 
            style="width: 100%; height: 100%; min-height: 280px; object-fit: cover; display: block;"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Core Values -->
  <section class="section section-alt" id="values">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-label">Our Principles</span>
        <h2>How We Serve Connecticut Homeowners</h2>
      </div>

      <div class="why-grid">
        <div class="why-item reveal">
          <div class="why-icon">⚡</div>
          <h3>24/7 Real Emergency Dispatch</h3>
          <p>Toilet emergencies don't stick to business hours. We maintain real on-duty dispatchers and technicians every night, weekend, and holiday.</p>
        </div>
        <div class="why-item reveal">
          <div class="why-icon">💵</div>
          <h3>Transparent Upfront Pricing</h3>
          <p>You receive an exact flat-rate price quote in writing before our plumbers begin. No surprise mileage, after-hours, or diagnostic add-ons.</p>
        </div>
        <div class="why-item reveal">
          <div class="why-icon">🛡️</div>
          <h3>Full Licensing & Insurance</h3>
          <p>Every technician is certified by the Connecticut Department of Consumer Protection and covered by comprehensive liability insurance.</p>
        </div>
        <div class="why-item reveal">
          <div class="why-icon">🚽</div>
          <h3>Commercial-Grade Parts</h3>
          <p>We install heavy-duty flappers, brass closet bolts, anti-siphon valves, and premium wax rings engineered for long-lasting performance.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <Testimonials />

  <!-- CTA Band -->
  <CTABand
    title="Need Reliable Toilet Repair in Connecticut?"
    subtitle="Speak directly with an on-duty technician right now. Upfront pricing and prompt local dispatch."
    primaryCta={{ text: `📞 Call 24/7: ${phone}`, href: `tel:${phoneClean}` }}
    secondaryCta={{ text: "View All 208 CT Cities", href: "/locations/" }}
  />

  <!-- Contact Section -->
  <ContactSection />

</BaseLayout>
