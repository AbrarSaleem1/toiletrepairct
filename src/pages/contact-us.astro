---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { siteConfig } from '../data/siteConfig';

const { businessName, phone, phoneClean, email, address, hours, primaryKeyword, experienceYears } = siteConfig;
const state = address.state;

// STRICT SEO LIMITS: Title <= 70 chars, Description <= 160 chars
const pageTitle = `Contact CT Toilet Repair Co. | 24/7 Emergency Hotline`;
const pageDescription = `Need immediate toilet repair in Connecticut? Contact CT Toilet Repair Co. 24/7 at (844) 352-0779 for rapid local dispatch across the state.`;

// ContactPage schema
const contactSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": `Contact ${businessName}`,
  "description": pageDescription,
  "url": `${siteConfig.domain}/contact-us/`,
  "mainEntity": {
    "@type": "PlumbingService",
    "name": businessName,
    "telephone": phone,
    "email": email,
    "address": {
      "@type": "PostalAddress",
      "streetAddress": address.street,
      "addressLocality": address.city,
      "addressRegion": address.stateAbbr,
      "postalCode": address.zip,
      "addressCountry": "US",
    },
    "openingHoursSpecification": [
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
        "opens": "00:00",
        "closes": "23:59"
      }
    ],
  },
});
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalUrl="/contact-us/" schema={contactSchema}>

  <!-- Hero -->
  <section class="hero hero-sm">
    <div class="hero-bg">
      <div style="width:100%;height:100%;background:linear-gradient(135deg, #052B3B 0%, #0A4D68 50%, #0F172A 100%);"></div>
    </div>
    <div class="hero-overlay" style="background: linear-gradient(135deg, rgba(5,43,59,0.7) 0%, rgba(10,77,104,0.5) 50%, rgba(15,23,42,0.7) 100%);"></div>
    <div class="container">
      <div class="hero-content fade-in-up">
        <Breadcrumb items={[
          { label: 'Home', href: '/' },
          { label: 'Contact Us' },
        ]} />
        <h1>24/7 Connecticut Emergency Hotline</h1>
        <p class="hero-subtitle">
          Active toilet overflow, stubborn clog, or persistent leak? Speak directly with an on-duty Connecticut dispatcher right now.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Content -->
  <section class="section" id="contact-main">
    <div class="container">
      <div class="contact-section">
        <!-- Contact Info -->
        <div class="contact-info reveal">
          <h3>Direct Contact Channels</h3>

          <div class="contact-detail">
            <div class="contact-detail-icon">📞</div>
            <div>
              <h4>24/7 Priority Phone Hotline</h4>
              <a href={`tel:${phoneClean}`} style="font-size: 1.35rem; font-weight: 800; color: var(--color-accent);">{phone}</a>
              <p>Toll-free 24/7 emergency dispatch across all 208 CT towns</p>
            </div>
          </div>

          <div class="contact-detail">
            <div class="contact-detail-icon">📍</div>
            <div>
              <h4>Central Office Headquarters</h4>
              <p>{address.street}<br />{address.city}, {address.stateAbbr} {address.zip}, USA</p>
              <p style="font-size: 0.8125rem; color: var(--color-text-light); margin-top: 0.25rem;">Mobile plumbing trucks deployed regionally statewide</p>
            </div>
          </div>

          <div class="contact-detail">
            <div class="contact-detail-icon">✉️</div>
            <div>
              <h4>Email Inquiries</h4>
              <a href={`mailto:${email}`}>{email}</a>
              <p>Billing questions & commercial service agreements</p>
            </div>
          </div>

          <div class="contact-detail">
            <div class="contact-detail-icon">🕐</div>
            <div>
              <h4>Dispatch Schedule</h4>
              <p style="font-weight: 700; color: var(--color-primary);">{hours.emergency}</p>
              <p>Standard & Emergency Appointments: 24/7/365</p>
            </div>
          </div>
        </div>

        <!-- Call Card (No Form) -->
        <div class="contact-form reveal" style="background: linear-gradient(145deg, #0A4D68 0%, #052B3B 100%); color: #ffffff; padding: var(--space-2xl); border-radius: var(--radius-lg); box-shadow: var(--shadow-xl); display: flex; flex-direction: column; justify-content: center;">
          <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(230, 81, 0, 0.2); border: 1px solid var(--color-accent); padding: 0.35rem 0.85rem; border-radius: 9999px; width: fit-content; margin-bottom: var(--space-md);">
            <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #22c55e;"></span>
            <span style="font-size: 0.8125rem; font-weight: 700; color: #ffedd5; text-transform: uppercase;">Direct Plumber Dispatch</span>
          </div>

          <h3 style="color: #ffffff; font-size: 1.75rem; margin-bottom: 0.75rem;">Call for Fastest Service</h3>
          <p style="color: #E0F2FE; font-size: 1rem; line-height: 1.6; margin-bottom: var(--space-xl);">
            When toilets back up or leak into the floor, every minute matters. Calling our direct line immediately connects you with a local dispatcher who will mobilize the nearest technician to your home or commercial building.
          </p>

          <a href={`tel:${phoneClean}`} class="btn btn-accent btn-lg" style="text-align: center; justify-content: center; font-size: 1.3rem; padding: 1.15rem 1.5rem; box-shadow: 0 10px 30px rgba(230,81,0,0.45); margin-bottom: var(--space-lg); font-weight: 800;">
            📞 Call {phone} Now
          </a>

          <div style="border-top: 1px solid rgba(208,208,208,0.15); padding-top: var(--space-lg); display: grid; gap: 0.65rem;">
            <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.9375rem; color: #f1f5f9;">
              <span style="color: #4ade80;">✓</span> <strong>{experienceYears} Years</strong> Connecticut Plumbing Experience
            </div>
            <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.9375rem; color: #f1f5f9;">
              <span style="color: #4ade80;">✓</span> <strong>Transparent Upfront Pricing</strong> — Flat rate quoted before work starts
            </div>
            <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.9375rem; color: #f1f5f9;">
              <span style="color: #4ade80;">✓</span> <strong>Fully Licensed & Insured</strong> Connecticut Plumbers
            </div>
            <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.9375rem; color: #f1f5f9;">
              <span style="color: #4ade80;">✓</span> Serving All <strong>208 Connecticut Communities</strong>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
